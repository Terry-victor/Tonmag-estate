# Firebase client configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Paystack: keep the secret server-side. Use sk_test_... locally first.
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only Firebase Admin service account. Accepts compact JSON or its base64 encoding.
# Its project_id must match NEXT_PUBLIC_FIREBASE_PROJECT_ID. Never use NEXT_PUBLIC_ for this value.
FIREBASE_SERVICE_ACCOUNT_JSON=

# One-time RBAC bootstrap. Set these only while running `npm run rbac:migrate`,
# then remove them. Legacy `admin` roles are never promoted unless explicitly enabled.
RBAC_BOOTSTRAP_SUPER_ADMIN_EMAIL=
RBAC_BOOTSTRAP_SUPER_ADMIN_PASSWORD=
RBAC_PROMOTE_LEGACY_ADMINS=false

# Set true only for local demonstrations without live credentials.
NEXT_PUBLIC_SAAS_DEMO_MODE=true

# Firebase Storage/CDN URL for the homepage hero video (MP4).
NEXT_PUBLIC_HERO_VIDEO_URL=

# Inspection booking payments and fallback bank transfer.
INSPECTION_BOOKING_FEE_NGN=
BANK_TRANSFER_BANK_NAME=
BANK_TRANSFER_ACCOUNT_NAME=
BANK_TRANSFER_ACCOUNT_NUMBER=

# Optional external booking notifications.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
OPS_NOTIFICATION_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
OPS_NOTIFICATION_PHONE=

# Optional legal-document Firebase CDN URLs.
NEXT_PUBLIC_TERMS_PDF_URL=
NEXT_PUBLIC_PRIVACY_PDF_URL=
NEXT_PUBLIC_INVESTMENT_AGREEMENT_PDF_URL=
NEXT_PUBLIC_PURCHASE_AGREEMENT_PDF_URL=
