{
  "auth": {
    "providers": {
      "anonymous": false,
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "TonMag Estate",
        "supportEmail": "victorterry25@gmail.com",
        "authorizedRedirectUris": [
          "https://tonmag-estate-prod.firebaseapp.com/__/auth/handler",
          "https://auth.tonmagestate.com/__/auth/handler",
          "https://www.tonmagestate.com/__/auth/handler",
          "http://localhost"
        ]
      }
    }
  },
  "hosting": {
    "site": "tonmag-estate-prod",
    "public": "firebase-auth-hosting",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "dataconnect": {
      "dataDir": "dataconnect/.dataconnect/pgliteData"
    }
  },
  "dataconnect": {
    "source": "dataconnect"
  },
  "apphosting": {
    "backendId": "tonmag-estate-web",
    "rootDir": "/",
    "ignore": [
      "node_modules",
      ".git",
      ".next",
      ".vercel",
      "firebase-debug.log",
      "firebase-debug.*.log"
    ]
  }
}
